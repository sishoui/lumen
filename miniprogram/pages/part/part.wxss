/* 部位编辑器样式。 */
.page { padding: 24rpx; }

.part-tabs { white-space: nowrap; padding: 8rpx 0; }
.slot-actions { display: flex; gap: 12rpx; }
.slot-actions .button { margin: 0; }
.part-tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #e5e5ea;
  font-size: 26rpx;
}
.part-tab.active {
  background: #007aff;
  color: #ffffff;
}

.led-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 4rpx;
  padding: 8rpx 0;
}
.led-cell {
  aspect-ratio: 1;
  font-size: 18rpx;
  background: #f2f2f7;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8e8e93;
}
.led-cell.occupied { background: #ffe5e5; color: #ff3b30; }
.led-cell.mine { background: #d1e9ff; color: #007aff; }

.seg-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.name-input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #d1d1d6;
  text-align: right;
}

.picker-text { font-size: 28rpx; color: #007aff; }

.button.danger { background: #ff3b30; }
.button.small { padding: 8rpx 16rpx; font-size: 24rpx; }
.button.disabled { opacity: 0.5; pointer-events: none; }