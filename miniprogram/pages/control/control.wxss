.page { padding: 24rpx; }
.header .title { font-size: 40rpx; font-weight: 700; color: #fff; display:block; }
.header .sub { font-size: 24rpx; color: #888; display:block; margin-top: 8rpx; }
.card { background: #1e1e1e; border-radius: 16rpx; padding: 24rpx; margin: 24rpx 0; }
.field { margin-bottom: 32rpx; }
.label { color: #ccc; font-size: 26rpx; display:block; margin-bottom: 8rpx; }
.seg { display:flex; gap:12rpx; }
.seg-item { flex:1; text-align:center; padding:18rpx 0; background:#2a2a2a; border-radius:8rpx; color:#aaa; font-size:24rpx; }
.seg-item.on { background:#007aff; color:#fff; }
.row { display:flex; gap:16rpx; }
.btn { font-size: 28rpx; }
.btn.primary { background: #007aff; color: #fff; }
.btn.secondary { background: #333; color: #fff; }
.btn.danger { background: #ff3b30; color: #fff; }
.log { margin-top: 24rpx; }
.log-title { color:#888; font-size:22rpx; display:block; margin-bottom:8rpx; }
.log-body { height: 240rpx; background:#0a0a0a; border-radius:8rpx; padding:8rpx; }
.log-line { font-size:20rpx; color:#aaa; display:block; line-height:1.4; }