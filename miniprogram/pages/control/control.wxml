<!--pages/control/control.wxml-->
<view class="page">
  <view class="header">
    <text class="title">灯效控制</text>
    <text class="sub">{{bleConnected ? ('已连接 ' + (deviceName || '')) : '未连接'}}</text>
  </view>

  <view class="card" wx:if="{{!bleConnected}}">
    <button class="btn primary" bindtap="goConnect">去连接设备</button>
  </view>

  <block wx:else>
    <view class="card">
      <view class="field">
        <text class="label">亮度 {{brightness}}</text>
        <slider min="0" max="255" value="{{brightness}}" activeColor="#007aff" block-size="20" bindchange="onBrightness" bindchanging="onBrightness" />
      </view>
      <view class="field">
        <text class="label">速度 {{speed}}</text>
        <slider min="1" max="100" value="{{speed}}" activeColor="#007aff" block-size="20" bindchange="onSpeed" bindchanging="onSpeed" />
      </view>
      <view class="field">
        <text class="label">相位模式</text>
        <view class="seg">
          <view class="seg-item {{phaseMode===0?'on':''}}" data-v="0" bindtap="onPhase">同相位（瀑布）</view>
          <view class="seg-item {{phaseMode===1?'on':''}}" data-v="1" bindtap="onPhase">错相位（波浪）</view>
        </view>
      </view>
      <view class="row">
        <button class="btn danger" bindtap="onReset">重置</button>
        <button class="btn secondary" bindtap="onQuery">查询状态</button>
      </view>
    </view>

    <view class="log">
      <text class="log-title">实时日志</text>
      <scroll-view scroll-y class="log-body">
        <text wx:for="{{logs}}" wx:key="index" class="log-line">{{item}}</text>
      </scroll-view>
    </view>
  </block>
</view>