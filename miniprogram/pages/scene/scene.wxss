/* 场景编辑器样式。 */
.page { padding: 24rpx; }

.part-tabs { white-space: nowrap; padding: 8rpx 0; }
.part-tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #e5e5ea;
  font-size: 26rpx;
}
.part-tab.active {
  background: #007aff;
  color: #ffffff;
}

.step-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f2f2f7;
  font-size: 26rpx;
}
.step-row.active { background: #e8f4ff; }
.step-num {
  width: 60rpx;
  font-weight: 600;
  color: #007aff;
}
.step-duration {
  width: 100rpx;
  color: #6e6e73;
}
.step-layer0, .step-layer1 {
  flex: 1;
  font-size: 24rpx;
  color: #1d1d1f;
}
.step-layer1 { color: #6e6e73; }

.name-input, .num-input {
  font-size: 28rpx;
  text-align: right;
}
.num-input { width: 200rpx; }

.name-bytes {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #8e8e93;
  white-space: nowrap;
}
.name-bytes.over { color: #ff3b30; }

.picker-text { font-size: 28rpx; color: #007aff; }

.row-actions {
  display: flex;
  gap: 8rpx;
}
.button.danger { background: #ff3b30; }
.button.small { padding: 8rpx 16rpx; font-size: 24rpx; }

.section-title {
  margin-top: 16rpx;
  border-top: 1rpx solid #d1d1d6;
}