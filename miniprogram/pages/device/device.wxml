<view class="page">
  <view class="page-title">设备</view>

  <view class="status-bar {{linkState === 'ready' ? '' : (linkState === 'reconnecting' ? 'reconnecting' : 'offline')}}">
    {{statusText}}
  </view>

  <view class="card">
    <view class="row">
      <text class="label">演示模式</text>
      <switch checked="{{mockMode}}" bindchange="onMockModeChange" />
    </view>
    <view class="hint">无真机记录时自动开启；可手动关闭连接真实设备</view>
  </view>

  <view wx:if="{{devices.length === 0}}" class="card">
    <view class="row" bindtap="onScanTap">
      <text class="value">扫描设备</text>
      <text class="hint">{{scanning ? '扫描中…' : '点击扫描 LUMEN- 设备'}}</text>
    </view>
  </view>

  <view wx:for="{{devices}}" wx:key="deviceId" class="device-card" bindtap="onDeviceTap" data-index="{{index}}">
    <view>
      <view class="device-name">{{item.name}}</view>
      <view class="device-meta">RSSI {{item.rssi}} · {{item.deviceId}}</view>
    </view>
    <view class="button">{{linkState === 'ready' && currentDeviceId === item.deviceId ? '已连接' : '连接'}}</view>
  </view>
</view>