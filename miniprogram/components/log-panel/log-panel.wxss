/* 日志面板样式。 */
.log-panel {
  position: fixed;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 60vh;
  background: rgba(0, 0, 0, 0.85);
  color: #ffffff;
  z-index: 999;
  display: flex;
  flex-direction: column;
}

.log-header {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 24rpx;
  border-bottom: 1rpx solid #333333;
}

.log-title { font-size: 26rpx; font-weight: 600; }
.log-actions { display: flex; gap: 24rpx; }
.log-action { font-size: 24rpx; color: #4daafc; }

.log-body { flex: 1; padding: 8rpx 12rpx; }
.log-row { display: flex; font-size: 20rpx; padding: 2rpx 0; font-family: monospace; }
.log-dir { width: 40rpx; }
.log-dir.tx { color: #4daafc; }
.log-dir.rx { color: #34c759; }
.log-seq { width: 80rpx; color: #8e8e93; }
.log-name { width: 180rpx; color: #ffd60a; }
.log-hex { flex: 1; word-break: break-all; }