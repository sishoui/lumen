# bt-light 固件 sdkconfig 默认值（ESP32-C3FH4 + ESP-IDF v6.1）。
# 工单 #5 resolution 锁定的 8 类键；其余依赖 ESP-IDF 默认。
#
# 目标与 flash
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# 分区表：NVS 64KB + app 0x3E0000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# NimBLE：仅外设 + 广播，单连接
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096

# 日志
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 项目自有（Kconfig.projbuild）
CONFIG_LUMEN_STRIP_PINS="3,10,0,1,4,5,6,7"
CONFIG_LUMEN_MAX_BRIGHTNESS=200
CONFIG_LUMEN_RENDER_TASK_STACK_SIZE=4096
CONFIG_LUMEN_RENDER_TASK_PRIORITY=4
CONFIG_LUMEN_STORE_TASK_STACK_SIZE=3072
CONFIG_LUMEN_STORE_TASK_PRIORITY=2
CONFIG_LUMEN_LED_COUNT=30
CONFIG_LUMEN_RMT_MEM_BLOCK_SYMBOLS=48